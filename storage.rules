rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /donation-receipts/{fileName} {
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if false;
      allow update, delete: if false;
    }
  }
}